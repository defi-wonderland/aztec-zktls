{
  "name": "aztec-zktls-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Primus zkTLS quote verifier PoC on Aztec",
  "repository": "https://github.com/defi-wonderland/aztec-zktls-poc.git",
  "author": "Wonderland",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "attest": "tsx src/ts/attest.ts",
    "prepare-witness": "tsx src/ts/prepare-witness.ts",
    "clean": "rm -rf ./src/artifacts ./target codegenCache.json",
    "compile": "aztec compile",
    "codegen": "aztec codegen target --outdir src/artifacts -f",
    "ccc": "yarn clean && yarn compile && yarn codegen",
    "test": "yarn test:nr && yarn test:js",
    "test:js": "vitest run",
    "test:nr": "aztec test",
    "test:e2e": "RUN_E2E=1 vitest run",
    "typecheck": "tsc --noEmit",
    "lint:prettier": "prettier '**/*.{js,ts}' --write",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts}": "prettier --write -u"
  },
  "dependencies": {
    "@aztec/accounts": "4.3.0",
    "@aztec/aztec.js": "4.3.0",
    "@aztec/bb.js": "4.3.0",
    "@aztec/wallets": "4.3.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "@primuslabs/network-core-sdk": "^0.1.5",
    "@types/node": "25.0.10",
    "dotenv": "^17.2.3",
    "ethers": "^5.7.2"
  },
  "devDependencies": {
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.2.0",
    "@types/node": "25.0.10",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.8.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.17"
  },
  "config": {
    "aztecVersion": "4.3.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "engines": {
    "node": ">=22.0.0",
    "yarn": ">=1.22.0"
  },
  "resolutions": {
    "@noble/hashes": "1.8.0",
    "@aztec/foundation": "4.3.0"
  }
}
